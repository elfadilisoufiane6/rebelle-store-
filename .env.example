# ────────────────────────────────────────────
#  REBELLE STORE — Backend env (example)
#  Copy to .env and fill real values
# ────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3001

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://rebelle.ma,https://www.rebelle.ma

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/rebelle

# Google Sheets (Apps Script Web App URL — no secret required, just the link)
SHEETS_WEBHOOK_URL=

# Meta (Facebook) Conversions API
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
FB_TEST_EVENT_CODE=

# TikTok Events API
TT_PIXEL_ID=
TT_ACCESS_TOKEN=

# Snapchat Conversions API
SC_PIXEL_ID=
SC_ACCESS_TOKEN=

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# ──────────────────────────────────────────────
# Admin dashboard (single-user)
# ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_long_random_string
# 32+ random bytes (hex) — used to sign the admin session cookie
ADMIN_SESSION_SECRET=
# Parent domain so the admin cookie is shared between the UI host
# (rebelle.ma) and this API host (api.rebelle.ma). MUST start with
# a leading dot in production. Leave empty for local dev.
ADMIN_COOKIE_DOMAIN=.rebelle.ma

# ──────────────────────────────────────────────
# IP intelligence (used by /api/track/click)
# ──────────────────────────────────────────────
# MaxMind GeoLite2 country DB — local .mmdb path
# Download once: https://www.maxmind.com/en/geolite2/signup (free)
# Mount the file into the container at this path.
MAXMIND_DB_PATH=/data/GeoLite2-Country.mmdb

# VPN / proxy detection — pick one provider + paste its key
#   VPN_API_PROVIDER ∈ { vpnapi | ipqualityscore | proxycheck }
VPN_API_PROVIDER=vpnapi
VPN_API_KEY=
