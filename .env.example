# ────────────────────────────────────────────
#  REBELLE STORE — Backend env (example)
#  Copy to .env and fill real values
# ────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3001

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://rebelle.ma,https://www.rebelle.ma

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/rebelle

# Google Sheets (Apps Script webhook URL)
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=rebelle2026

# Meta (Facebook) Conversions API
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
FB_TEST_EVENT_CODE=

# TikTok Events API
TT_PIXEL_ID=
TT_ACCESS_TOKEN=

# Snapchat Conversions API
SC_PIXEL_ID=
SC_ACCESS_TOKEN=

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
